#include <bits/stdc++.h>
using namespace std;
int main(){
    long long t;
    cin>>t;
    while(t--){
        string s;
        cin>>s;
        int sum1=0,sum2=0;
        for(char c:s){
            c=c-'a'+'0';
        }
        for(int i=0;i<s.length()/2;i++){
            sum1+=s[i];
        }
        for(int i=s.length()/2;i<s.length();i++){
            sum2+=s[i];
        }
        if(sum1==sum2){
            cout<<"YES"<<endl;
        }
        else cout<<"NO"<<endl;
    }
    return 0;
}