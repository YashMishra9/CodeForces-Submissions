#include <bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        string s;
        cin>>s;
        int sum=0;
        for(int i=0;i<s.length();i++){
            s[i]=s[i]-'a'+'1';
            sum+=s[i];
        }
        cout<<sum<<endl;
 
    }
    return 0;
}